# --- Secrets: never commit real credentials ---
# Matches at any depth: .env, backend/.env, etc.
.env
**/.env
.env.*
**/.env.*
# But keep safe templates
!.env.example
!**/.env.example

# Keys, certs, tokens
*.pem
*.key
*.p12
*.pfx
secrets.toml
*credentials*.json
*secret*.json

# --- Go backend ---
# Binaries / build output
backend/server
backend/bin/
backend/out/
backend/tmp/
*.exe
*.out
*.test

# Go module cache / vendor (if you ever vendor)
vendor/

# --- Local dev tools ---
# LazyCurl environments may hold secrets (sessions are UI state, kept)
**/.lazycurl/environments/
*.har

# Docker overrides with secrets
docker-compose.override.yml

# --- Editors / OS ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
